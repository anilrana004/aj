root: true

packages:
  - apps/web
  - packages/database

plugins:
  - @vercel/next-on-pages

experimental:
  optimizeCss: true
  optimizePackageImports:
    - '@headlessui/react'
    - '@radix-ui/react'
    - 'lucide-react'

outputDirectory: .next

sqlite:
  migrations:
    directory: .next/db/migrations

headers:
  '/**/*.svg':
    - cache-control: public, max-age=31536000, immutable
  '/**/*.webp':
    - cache-control: public, max-age=31536000, immutable
  '/**/*.avif':
    - cache-control: public, max-age=31536000, immutable

security:
  headers:
    - for: /api/*
      headers:
        - key: X-Content-Type-Options
          value: nosniff
        - key: X-Frame-Options
          value: DENY
        - key: X-XSS-Protection
          value: '1; mode=block'

supports:
  nodejs: 18.x
  browsers:
    - '>0.25%'
    - not op_mini all
    - not dead

s/workflows:
  - path: .github/workflows/deploy.yml
    name: Deploy to Vercel
  - path: .github/workflows/ci.yml
    name: CI Pipeline

preview:
  domain: branch-approver.vercel.app
  secret: ${{ secrets.VERCEL_DEPLOY_TOKEN }}