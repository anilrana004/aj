generator js2ts > packages/database/prisma/types.ts
mode du -h

cat > packages/database/prisma/schema.prisma << 'EOF'
// Apriliha Singh Jewelry Database Schema
// Implements the bespoke jewelry builder data model

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(cuid())
  email              String     @unique
  name               String?
  image              String?
  passwordHash       String?
  emailVerified      DateTime?
  role               String     @default('customer')
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accounts           Account[]
  orders            Order[]
  savedDesigns      SavedDesign[]
}

model Account {
  id                 String    @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id                 String    @id @default(cuid())
  sessionToken       String     @unique
  userId             String
  expires            DateTime

  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier         String
  expires            DateTime
  token              String     @unique

  @@unique([identifier, token])
}

model Category {
  id                 String     @id @default(cuid())
  slug               String     @unique   // "necklace" | "bracelet" | "mala" | "ring" | "earring"
  name               String
  description        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  partTypes          PartType[]

  @@index([slug])
}

model PartType {
  id                 String     @id @default(cuid())
  categoryId         String
  slug               String              // "base" | "centerpiece" | "stone" | "clasp" | "length" | "finish"
  name               String
  isRequired         Boolean    @default(true)
  sortOrder          Int
  allowMultiple      Boolean    @default(false)   // e.g. multiple "stone" parts allowed
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  category           Category   @relation(fields: [categoryId], references: [id])
  parts              Part[]

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model Part {
  id                 String     @id @default(cuid())
  partTypeId         String
  name               String                 // "Oxidized Bronze Chain, 18-inch"
  slug               String   @unique
  price              Decimal                // individual price, always shown
  story              String   @db.Text      // short editorial paragraph, unique per part
  origin             String?                // e.g. "Jaipur, Rajasthan"
  material           String?
  images             String[]               // array of image URLs, used in live preview + gallery
  isAvailable        Boolean    @default(true)
  stock              Int?                   // null = made to order, no stock cap
  leadTimeDays       Int        @default(14)  // bespoke = longer lead time
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  partType           PartType   @relation(fields: [partTypeId], references: [id])
  savedDesigns       Json       // Reference to where this part is used

  @@index([partTypeId])
  @@index([slug])
  @@index([isAvailable])
}

model Order {
  id                 String    @id @default(cuid())
  userId             String?
  guestToken         String?
  orderNumber        String    @unique
  email              String
  shippingAddress    Json
  billingAddress     Json?
  status             String    @default('pending_payment')
  currency           String     @default('INR')
  subtotal           Decimal
  shipping           Decimal    @default(0)
  tax                Decimal    @default(0)
  total              Decimal
  paymentMethod      String?
  paymentIntentId    String?
  paymentStatus      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user               User?      @relation(fields: [userId], references: [id])
  orderItems         OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  productId          String?
  partConfig         Json       // For bespoke items: { partId, quantity, price, name, story }
  productName        String?    // For fixed-price products
  quantity           Int        @default(1)
  price              Decimal
  isBespoke          Boolean    @default(false)
  createdAt          DateTime   @default(now())

  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model SavedDesign {
  id                 String    @id @default(cuid())
  userId             String?
  guestToken         String?
  categoryId         String
  parts              Json                     // array of { partTypeId, partId, quantity }
  totalPrice         Decimal
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user               User?       @relation(fields: [userId], references: [id])

  @@index([categoryId])
  @@index([createdAt])
}

model Product {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  collectionId       String
  description        String   @db.Text
  shortDescription   String?
  price              Decimal
  currency           String    @default('INR')
  images             String[]
  isAvailable        Boolean   @default(true)
  isFeatured         Boolean   @default(false)
  metadata           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  collection         Collection @relation(fields: [collectionId], references: [id])

  @@index([slug])
  @@index([collectionId])
  @@index([isAvailable])
}

model Collection {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  description        String   @db.Text
  story             String   @db.Text
  heroImage          String?
  heroImageAlt       String?
  isActive          Boolean   @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  products           Product[]

  @@index([slug])
  @@index([isActive])
}

model Wishlist {
  id                 String    @id @default(cuid())
  userId             String
  productId          String
  partConfig         Json?     // optional config for bespoke wishlist items
  createdAt          DateTime   @default(now())

  user               User       @relation(fields: [userId], references: [id])
  product            Product    @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model JournalArticle {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  dek               String?
  heroImage          String?
  heroImageAlt       String?
  author             String
  authorRole         String?
  publishedAt        DateTime
  readTime          Int
  category          String    // "atelier", "craft", "story"
  isFeatured         Boolean   @default(false)
  content           Json       @db.Text
  tags              String[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([slug])
  @@index([publishedAt])
  @@index([isFeatured, category])
}

model AtelierContent {
  id                 String    @id @default(cuid())
  section            String    @unique
  content            String    @db.Text
  image              String?
  imageAlt           String?
  order              Int       @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([order])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               String    @default('staff')
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLoginAt        DateTime?
}